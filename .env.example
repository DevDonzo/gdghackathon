# App
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ratedrop?retryWrites=true&w=majority
RATEDROP_ALLOW_MEMORY_DB=true

# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash

# Twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
TWILIO_VERIFY_ORIG_NUMBERS=+1xxxxxxxxxx,+1yyyyyyyyyy
TWILIO_SANDBOX_TO_NUMBER=+1xxxxxxxxxx
RATEDROP_FORCE_SIMULATED_CALLS=false

# Optional local dev
NGROK_AUTHTOKEN=your_ngrok_token
PUBLIC_BASE_URL=https://your-ngrok-or-deployed-api-url
FRONTEND_BASE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
